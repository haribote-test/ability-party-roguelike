import {QUESTIONS,ABILITIES,WEAPONS,UPGRADES} from "./data.js";
const $=s=>document.querySelector(s),c=$("#gameCanvas"),ctx=c.getContext("2d");
let qi=0,scores={power:0,speed:0,control:0,support:0},state,running=false,keys={},last=0,spawn=0,pending;
const types=["power","speed","control","support"];
function show(id){document.querySelectorAll(".screen").forEach(x=>x.classList.remove("active"));$(id).classList.add("active")}
function overlay(id,v){$(id).classList.toggle("active",v)}
$("#startBtn").onclick=()=>{qi=0;scores={power:0,speed:0,control:0,support:0};quiz()};
function quiz(){show("#quiz");let q=QUESTIONS[qi];$("#qCount").textContent=`QUESTION ${qi+1}/${QUESTIONS.length}`;$("#qType").textContent=q.t;$("#question").textContent=q.q;let box=$("#answers");box.innerHTML="";q.a.forEach(([t,k])=>{let b=document.createElement("button");b.textContent=t;b.onclick=()=>{scores[k]++;qi++;qi<QUESTIONS.length?quiz():start()};box.appendChild(b)})}
function top(s){return Object.entries(s).sort((a,b)=>b[1]-a[1])[0][0]}
function actor(type,i=0,player=false){let w=player?WEAPONS[0]:WEAPONS[(i+1)%4];return{x:player?550:360+i*105,y:player?325:260+(i%2)*120,r:player?14:12,hp:player?110:100,maxHp:player?110:100,attack:player?22:18,speed:player?185:150,range:player?110:100,rate:player?650:700,shot:Math.random()*500,regen:player?0:.2,pierce:0,teamBonus:0,abilityPower:1,abilityType:type,ability:ABILITIES[type],weapon:w,kills:0,damage:0,xp:0,level:1,nextXp:12,ai:!player}}
function start(){let t=top(scores);state={time:180,player:actor(t,0,true),party:[],enemies:[],bullets:[],orbs:[],kills:0,damage:0,drops:0};state.party=[state.player,...types.map((x,i)=>actor(x,i))];running=true;show("#game");hud();requestAnimationFrame(loop)}
function loop(t){if(!running)return;let dt=Math.min(.033,(t-last)/1000||.016);last=t;update(dt);draw();requestAnimationFrame(loop)}
function update(dt){state.time-=dt;if(state.time<=0)return finish(true);spawn-=dt;if(spawn<=0){spawn=Math.max(.18,1.05-state.time/300);enemy();if(Math.random()<.08)enemy(true)}
let p=state.player,dx=(keys.ArrowRight||keys.d?1:0)-(keys.ArrowLeft||keys.a?1:0),dy=(keys.ArrowDown||keys.s?1:0)-(keys.ArrowUp||keys.w?1:0);if(dx||dy){let l=Math.hypot(dx,dy);p.x+=dx/l*p.speed*dt;p.y+=dy/l*p.speed*dt}p.x=Math.max(20,Math.min(c.width-20,p.x));p.y=Math.max(80,Math.min(c.height-20,p.y));
state.party.forEach(a=>{a.hp=Math.min(a.maxHp,a.hp+a.regen*dt);if(a!==p)ai(a,dt)});auto(p,dt);state.party.filter(a=>a!==p).forEach(a=>auto(a,dt));bullets(dt);enemies(dt);orbs(dt);if(Math.random()<dt*.012&&state.kills>4)drop();if(state.party.every(a=>a.hp<=0))finish(false);hud()}
function ai(a,dt){let tar=state.enemies[0];if(a.abilityType==="support"){let low=state.party.filter(x=>x.hp<x.maxHp*.65).sort((x,y)=>x.hp/x.maxHp-y.hp/y.maxHp)[0];if(low){let dx=low.x-a.x,dy=low.y-a.y,d=Math.hypot(dx,dy)||1;if(d>95){a.x+=dx/d*a.speed*dt;a.y+=dy/d*a.speed*dt}}}else if(tar){let dx=tar.x-a.x,dy=tar.y-a.y,d=Math.hypot(dx,dy)||1;if(d>a.range*.65){a.x+=dx/d*a.speed*dt;a.y+=dy/d*a.speed*dt}}a.x=Math.max(20,Math.min(c.width-20,a.x));a.y=Math.max(80,Math.min(c.height-20,a.y))}
function auto(a,dt){if(a.hp<=0)return;a.shot-=dt*1000;if(a.shot>0)return;let t=state.enemies.reduce((b,e)=>{let d=Math.hypot(e.x-a.x,e.y-a.y);return d<=a.range&&(!b||d<b.d)?{e,d}:b},null);if(!t)return;a.shot=a.rate;let dx=t.e.x-a.x,dy=t.e.y-a.y,d=Math.hypot(dx,dy)||1,dmg=a.attack;if(a.abilityType==="support"&&state.party.some(x=>x!==a&&Math.hypot(x.x-a.x,x.y-a.y)<140))dmg*=1+a.teamBonus+.18*a.abilityPower;if(a.weapon.kind===a.abilityType)dmg*=1+.12*a.abilityPower;state.bullets.push({x:a.x,y:a.y,vx:dx/d*500,vy:dy/d*500,r:5,damage:dmg,owner:a,pierce:a.pierce,life:1.5,slow:a.abilityType==="control"?.35:0});if(a.weapon.kind==="support")heal(a,4+3*a.abilityPower)}
function heal(a,n){state.party.forEach(x=>{if(x!==a&&Math.hypot(x.x-a.x,x.y-a.y)<170)x.hp=Math.min(x.maxHp,x.hp+n)})}
function enemy(elite=false){let s=Math.floor(Math.random()*4),x=s===0?30:s===1?c.width-30:Math.random()*c.width,y=s===2?75:s===3?c.height-30:90+Math.random()*(c.height-120),hp=(elite?110:28+state.time*.15)*(1+Math.min(1.2,(180-state.time)/150));state.enemies.push({x,y,r:elite?15:10,hp,maxHp:hp,speed:elite?38:55+Math.random()*25,elite,slow:0})}
function enemies(dt){for(let i=state.enemies.length-1;i>=0;i--){let e=state.enemies[i];e.slow=Math.max(0,e.slow-dt);let ts=state.party.filter(a=>a.hp>0);if(!ts.length)continue;let tar=ts.reduce((b,a)=>!b||Math.hypot(e.x-a.x,e.y-a.y)<Math.hypot(e.x-b.x,e.y-b.y)?a:b,null),dx=tar.x-e.x,dy=tar.y-e.y,d=Math.hypot(dx,dy)||1;e.x+=dx/d*e.speed*(1-e.slow)*dt;e.y+=dy/d*e.speed*(1-e.slow)*dt;if(d<e.r+tar.r)tar.hp-=(e.elite?18:8)*dt}}
function bullets(dt){for(let i=state.bullets.length-1;i>=0;i--){let b=state.bullets[i];b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;for(let j=state.enemies.length-1;j>=0;j--){let e=state.enemies[j];if(Math.hypot(e.x-b.x,e.y-b.y)<e.r+b.r){e.hp-=b.damage;b.owner.damage+=b.damage;if(b.slow)e.slow=Math.max(e.slow,b.slow);if(e.hp<=0){state.enemies.splice(j,1);state.kills++;b.owner.kills++;orb(e.x,e.y);if(b.owner===state.player)gain()}if(b.pierce>0)b.pierce--;else{b.life=0;break}}}if(b.life<=0||b.x<0||b.x>c.width||b.y<70||b.y>c.height)state.bullets.splice(i,1)}}
function orb(x,y){state.orbs.push({x,y})}
function gain(){let p=state.player;p.xp++;if(p.xp>=p.nextXp){p.xp-=p.nextXp;p.level++;p.nextXp=Math.floor(p.nextXp*1.35);level()}}
function orbs(dt){let p=state.player;for(let i=state.orbs.length-1;i>=0;i--){let o=state.orbs[i],d=Math.hypot(p.x-o.x,p.y-o.y);if(d<150){o.x+=(p.x-o.x)/Math.max(d,1)*260*dt;o.y+=(p.y-o.y)/Math.max(d,1)*260*dt}if(d<18){state.orbs.splice(i,1);gain()}}}
function level(){running=false;overlay("#levelup",true);let box=$("#upgradeChoices");box.innerHTML="";[...UPGRADES].sort(()=>Math.random()-.5).slice(0,3).forEach(u=>{let b=document.createElement("button");b.innerHTML=`<b>${u.name}</b><br><small>${u.desc}</small>`;b.onclick=()=>{u.apply(state.player);overlay("#levelup",false);running=true;last=performance.now();requestAnimationFrame(loop)};box.appendChild(b)})}
function drop(){state.drops++;pending=WEAPONS[Math.floor(Math.random()*WEAPONS.length)];$("#dropTitle").textContent=pending.name;$("#dropText").textContent=pending.desc;overlay("#weaponDrop",true);running=false}
$("#equipBtn").onclick=()=>{state.player.weapon=pending;overlay("#weaponDrop",false);running=true;last=performance.now();requestAnimationFrame(loop)}
$("#keepBtn").onclick=()=>{overlay("#weaponDrop",false);running=true;last=performance.now();requestAnimationFrame(loop)}
function hud(){let p=state?.player;if(!p)return;$("#timer").textContent=`${String(Math.ceil(state.time/60)).padStart(2,"0")}:${String(Math.ceil(state.time%60)).padStart(2,"0")}`;$("#level").textContent=p.level;$("#partyHp").textContent=Math.round(state.party.reduce((s,a)=>s+a.hp/a.maxHp,0)/4*100)+"%";$("#abilityName").textContent=`能力：${p.ability.name}`;$("#weaponName").textContent=`武器：${p.weapon.name}`}
function finish(win){running=false;show("#result");$("#resultTitle").textContent=win?"SURVIVED!":"PT DEFEATED";$("#resultStats").innerHTML=`<div>固有能力：<b>${state.player.ability.name}</b></div><div>最終武器：<b>${state.player.weapon.name}</b></div><div>レベル：<b>${state.player.level}</b></div><div>撃破数：<b>${state.kills}</b></div><div>総ダメージ：<b>${Math.round(state.damage)}</b></div><div>武器ドロップ：<b>${state.drops}</b></div>`}
function draw(){ctx.clearRect(0,0,c.width,c.height);ctx.fillStyle="#0b1020";ctx.fillRect(0,0,c.width,c.height);ctx.strokeStyle="#161e35";for(let x=0;x<c.width;x+=50){ctx.beginPath();ctx.moveTo(x,70);ctx.lineTo(x,c.height);ctx.stroke()}for(let y=70;y<c.height;y+=50){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(c.width,y);ctx.stroke()}state.orbs.forEach(o=>{ctx.fillStyle="#78e4ff";ctx.beginPath();ctx.arc(o.x,o.y,4,0,7);ctx.fill()});state.bullets.forEach(b=>{ctx.fillStyle="#fff";ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,7);ctx.fill()});state.enemies.forEach(e=>{ctx.fillStyle=e.elite?"#ff7b7b":"#a94b64";ctx.beginPath();ctx.arc(e.x,e.y,e.r,0,7);ctx.fill()});state.party.forEach((a,i)=>{ctx.fillStyle=a===state.player?a.ability.color:"#6474a8";ctx.beginPath();ctx.arc(a.x,a.y,a.r,0,7);ctx.fill();ctx.fillStyle="#fff";ctx.font="11px sans-serif";ctx.textAlign="center";ctx.fillText(a===state.player?"YOU":`AI${i}`,a.x,a.y-18);ctx.fillStyle="#202638";ctx.fillRect(a.x-18,a.y+18,36,4);ctx.fillStyle="#75e19a";ctx.fillRect(a.x-18,a.y+18,36*Math.max(0,a.hp/a.maxHp),4)})}
addEventListener("keydown",e=>{keys[e.key]=true;if(e.key.startsWith("Arrow"))e.preventDefault()});addEventListener("keyup",e=>keys[e.key]=false);$("#retryBtn").onclick=()=>show("#title");
